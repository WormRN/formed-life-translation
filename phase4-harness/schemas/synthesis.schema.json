{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verse_renderings", "change_log", "unresolved_decisions", "self_assessment"],
  "properties": {
    "verse_renderings": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "object", "additionalProperties": false, "required": ["reference", "text"], "properties": {"reference": {"type": "string"}, "text": {"type": "string", "minLength": 1}}}},
    "change_log": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["reference", "choice", "warrant"], "properties": {"reference": {"type": "string", "minLength": 1}, "choice": {"type": "string", "minLength": 1}, "warrant": {"type": "string", "minLength": 1}}}},
    "unresolved_decisions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["reference", "question", "options"], "properties": {"reference": {"type": "string", "minLength": 1}, "question": {"type": "string", "minLength": 1}, "options": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}}}},
    "self_assessment": {"type": "string", "minLength": 1}
  }
}
