{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FLT Run Manifest",
  "type": "object",
  "required": [
    "run_id",
    "project",
    "book",
    "chapter",
    "phase",
    "status",
    "created_at",
    "source_text",
    "governing_documents",
    "units",
    "models",
    "benchmark_policy"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^FLT-[A-Z0-9]+-[0-9]{2}-[0-9]{8}-[0-9]{3}$"
    },
    "project": {
      "const": "Formed Life Translation"
    },
    "book": {
      "type": "string"
    },
    "chapter": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "const": "3"
    },
    "status": {
      "enum": [
        "initialized",
        "running",
        "blocked",
        "completed",
        "failed",
        "frozen"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_text": {
      "type": "object",
      "required": [
        "edition",
        "repository_path",
        "sha256"
      ],
      "properties": {
        "edition": {
          "const": "SBLGNT"
        },
        "repository_path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "governing_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "repository_path",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "repository_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "unit_id",
          "verse_start",
          "verse_end"
        ],
        "properties": {
          "unit_id": {
            "type": "string"
          },
          "verse_start": {
            "type": "integer",
            "minimum": 1
          },
          "verse_end": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "minItems": 1
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "provider",
          "model",
          "prompt_version"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "prompt_version": {
            "type": "string"
          }
        }
      }
    },
    "benchmark_policy": {
      "type": "object",
      "required": [
        "benchmark_path",
        "hidden_from_blind_roles"
      ],
      "properties": {
        "benchmark_path": {
          "type": "string"
        },
        "hidden_from_blind_roles": {
          "const": true
        }
      }
    }
  },
  "additionalProperties": false
}